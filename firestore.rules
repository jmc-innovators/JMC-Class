rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return myUserDoc().data;
    }

    function isOperatorEmail() {
      return request.auth.token.email != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'info@jmcinnovator.cc.cd' ||
          request.auth.token.email == 'innovatorsjmc@gmail.com' ||
          request.auth.token.email == 'jmc.class2027@gmail.com' ||
          request.auth.token.email == 'operator@jmc.internal' ||
          request.auth.token.email == 'operator@jmc.com'
        );
    }

    function isOperator() {
      return signedIn() && (
        isOperatorEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myUser().role == 'operator')
      );
    }

    function isApprovedSchoolAdminFor(schoolId) {
      let schoolData = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return signedIn() && (
        (
          request.auth.token.email != null
          && request.auth.token.email_verified == true
          && (
            schoolData.administratorEmail == request.auth.token.email ||
            schoolData.adminEmail == request.auth.token.email
          )
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && myUser().role in ['school', 'supervisor']
          && myUser().schoolId == schoolId
        )
      );
    }

    // ----------------------------------------------------------
    // Connection Validation Path (Read-only for startup health ping)
    // ----------------------------------------------------------
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /_connection_test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------------------------------------
    // Users Collection (PII & RBAC Protected)
    // ----------------------------------------------------------
    match /users/{uid} {
      allow get: if isOperator() || (signedIn() && request.auth.uid == uid);
      allow list: if isOperator();
      allow create: if isOperator() || (
        signedIn()
        && request.auth.uid == uid
        && (request.resource.data.role != 'operator' || isOperatorEmail())
      );
      allow update: if isOperator() || (
        signedIn()
        && request.auth.uid == uid
        && (request.resource.data.role != 'operator' || isOperatorEmail())
      );
      allow delete: if isOperator();
    }

    // ----------------------------------------------------------
    // Google Workspace Automation Config (Non-secret IDs, Operator Only)
    // ----------------------------------------------------------
    match /system_config/{configId} {
      allow read, write: if isOperator();
    }

    // ----------------------------------------------------------
    // School Registration Applications
    // ----------------------------------------------------------
    match /school_applications/{applicationId} {
      // Visitors can submit new pending school applications
      allow create: if request.resource.data.status == 'PENDING'
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.schoolName.size() <= 200
        && request.resource.data.administratorEmail is string
        && request.resource.data.administratorEmail.size() > 0
        && request.resource.data.administratorEmail.size() <= 200;
      // Only verified Platform Operators can read, list, update (approve/reject), or delete applications
      allow read, update, delete: if isOperator();
    }

    // ----------------------------------------------------------
    // Invites Collection (Email to Role mappings)
    // ----------------------------------------------------------
    match /invites/{email} {
      allow get: if isOperator() || (
        signedIn() && request.auth.token.email != null && request.auth.token.email == email
      );
      allow list: if isOperator();
      allow create, update, delete: if isOperator() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().role in ['school', 'supervisor']
      );
    }

    // ----------------------------------------------------------
    // Legacy top-level collections for backwards compatibility
    // ----------------------------------------------------------
    match /supervisors/{supervisorId} {
      allow read, write: if signedIn();
    }

    match /teachers/{teacherId} {
      allow read, write: if signedIn();
    }

    // ----------------------------------------------------------
    // Schools & School Subcollections
    // ----------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if true;
      allow create, delete: if isOperator();
      allow update: if isOperator() || isApprovedSchoolAdminFor(schoolId);

      // Classes
      match /classes/{classId} {
        allow read, write: if signedIn();

        match /students/{studentId} {
          allow read, write: if signedIn();
        }
      }

      // Teachers roster
      match /teachers/{teacherId} {
        allow read, write: if signedIn();
      }

      // Students roster
      match /students/{studentId} {
        allow read, write: if signedIn();
      }

      // Parents roster
      match /parents/{parentId} {
        allow read, write: if signedIn();
      }

      // Subjects
      match /subjects/{subjectId} {
        allow read, write: if signedIn();
      }

      // Assignments
      match /assignments/{assignmentId} {
        allow read, write: if signedIn();
      }

      // Submissions
      match /submissions/{submissionId} {
        allow read, write: if signedIn();
      }

      // Attendance
      match /attendance/{attendanceId} {
        allow read, write: if signedIn();
      }

      // Results / Assessment Marks
      match /results/{resultId} {
        allow read, write: if signedIn();
      }

      // Timetables
      match /timetables/{timetableId} {
        allow read, write: if signedIn();
      }

      // Announcements
      match /announcements/{announcementId} {
        allow read, write: if signedIn();
      }

      // Direct & Class Messages
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }

      // Immutable Audit Logs
      match /auditLogs/{logId} {
        allow read, create: if signedIn();
        allow update, delete: if false;
      }
    }
  }
}
