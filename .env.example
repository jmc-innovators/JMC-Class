# Gemini AI API Key (Server-side)
GEMINI_API_KEY=

# Firebase Client API Key (Optional override)
VITE_FIREBASE_API_KEY=

# Server Port (Default: 3000)
PORT=3000

# Google Sheets Integration Web App URL (Google Apps Script)
# Deploy Code.gs as Web App in your Google Sheet, then paste the exec URL here:
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
